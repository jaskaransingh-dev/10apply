---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WaitlistJoin from '~/components/widgets/WaitlistJoin.astro';

const metadata = {
  title: 'Join as an employer — Qualify',
  description: 'Hold your hiring spot. Post a job, meet ranked candidates. Join the employer waitlist.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Employer waitlist"
    title="Post a job.<br />Meet matches."
    subtitle="Tell us what you're hiring below. When your spot opens, you'll get a ranked shortlist of every matching candidate."
  />
  <div class="mx-auto max-w-3xl px-4 pb-16">
    <WaitlistJoin side="employer" />
    <p class="mt-4 text-center text-sm text-muted">
      Looking for work? <a href="/waitlist/candidate" class="font-semibold underline underline-offset-4">Join as a candidate</a>
    </p>
  </div>
</Layout>
