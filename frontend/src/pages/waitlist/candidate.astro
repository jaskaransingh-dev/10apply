---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WaitlistJoin from '~/components/widgets/WaitlistJoin.astro';

const metadata = {
  title: 'Join as a candidate — Discovered',
  description: 'Drop your resume once. Get discovered by ranked companies. Join the candidate waitlist.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Candidate waitlist"
    title="Upload once.<br />You're done."
    subtitle="Drop your resume below — name, email and skills are read automatically. When your spot opens, companies start reaching out by email."
  />
  <div class="mx-auto max-w-3xl px-4 pb-16">
    <WaitlistJoin side="candidate" />
    <p class="mt-4 text-center text-sm text-muted">
      Hiring instead? <a href="/waitlist/employer" class="font-semibold underline underline-offset-4">Join as an employer</a>
    </p>
  </div>
</Layout>
